# Public site URL (no trailing slash) — used for Paystack callback and share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack (Settings → API Keys & Webhooks). Use sk_test_ while testing.
PAYSTACK_SECRET_KEY=sk_test_xxx

# Odogwu's cut of every spray pack, in percent. Paystack's own fee is paid out of this.
PLATFORM_FEE_PERCENT=5
# Flat part of the fee in naira (5% + ₦100 by default). Paystack's own fee is paid out of this.
PLATFORM_FEE_FLAT=100

# Password for the private demo-visits page: /admin/visits?key=THIS_VALUE (20+ random characters)
ADMIN_KEY=use-at-least-20-random-characters

# Shown in the footer, Help page and Terms for support
NEXT_PUBLIC_SUPPORT_EMAIL=the36thltd@outlook.com

# One-off price (naira) for a host to unlock premium wall themes. 0 = free (e.g. during your pilot).
THEME_PRICE_NAIRA=5000

# Let guests abroad pick their country and pay with foreign cards. Set to true only after Paystack approves international payments.
NEXT_PUBLIC_ABROAD_ENABLED=false

# Email (resend.com): host links and sign-in codes. Verify your domain in Resend before launch,
# otherwise Resend only delivers to your own account email.
RESEND_API_KEY=re_xxx
EMAIL_FROM=Odogwu <hello@yourdomain.com>

# Where alerts and your daily summary email go (defaults to NEXT_PUBLIC_SUPPORT_EMAIL)
ADMIN_EMAIL=the36thltd@outlook.com

# Protects the daily job (/api/cron/daily). Any long random string; Vercel sends it automatically.
CRON_SECRET=use-at-least-32-random-characters

# Share for venues and planners who sign themselves up at /partners, in % of spray pack value (0–5)
PARTNER_SHARE_PERCENT=1

# Android app (Play Store). Package name, and the SHA-256 fingerprints from Play Console → App integrity
# (app signing key AND upload key, comma-separated). Served at /.well-known/assetlinks.json
ANDROID_PACKAGE=online.odogwu.app
ANDROID_SHA256=
# Once the app is live: Android visitors get a "Get the Android app" button instead of "Install"
NEXT_PUBLIC_PLAY_STORE_URL=
