# Public site URL (no trailing slash) — used for Paystack callback and share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack (Settings → API Keys & Webhooks). Use sk_test_ while testing.
PAYSTACK_SECRET_KEY=sk_test_xxx

# Odogwu's cut of every spray pack, in percent. Paystack's own fee is paid out of this.
PLATFORM_FEE_PERCENT=5
